{
  "name": "aromati-cafe-wine-bar",
  "private": true,
  "version": "1.0.0",
  "description": "AROMATI Cafe & Wine Bar — static site (plain HTML/CSS/JS, served by Vite for preview)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run check:fonts && npm run test:fonts && npm run check:csp && npm run check:vendor && npm run test:pages && npm run test:hours && npm run test:copy && npm run test:ordering && npm run test:guards && npm run test:admin && npm run test:sql && npm run test:rls && npm run test:dbguards && npm run test:live && npm run test:policies && npm run check:policies && npm run check:seed && npm run check:memory && npm run check:layout && npm run test:replay",
    "test:admin": "node tools/test-admin.mjs",
    "check:vendor": "node tools/check-vendor.mjs",
    "test:sql": "node tools/test-sql.mjs",
    "test:rls": "node tools/test-rls.mjs",
    "test:dbguards": "node tools/test-db-guards.mjs",
    "test:live": "node tools/test-live.mjs",
    "test:pages": "node tools/verify-phase1.mjs",
    "test:hours": "node tools/test-hours.mjs",
    "test:copy": "node tools/test-copy.mjs",
    "test:ordering": "node tools/test-ordering.mjs",
    "test:guards": "node tools/test-guards.mjs",
    "test:policies": "node tools/test-policies.mjs",
    "check:policies": "node tools/check-policies.mjs",
    "check:seed": "node tools/gen-seed-sql.mjs --check",
    "check:memory": "node tools/check-memory.mjs",
    "extract": "node tools/extract-menus.mjs && node tools/extract-copy.mjs",
    "gen:seed": "node tools/gen-seed-sql.mjs",
    "check:layout": "node tools/measure-font-shift.mjs",
    "fetch:fonts": "node tools/fetch-fonts.mjs",
    "check:fonts": "node tools/check-fonts.mjs",
    "test:fonts": "node tools/test-fonts.mjs",
    "check:csp": "node tools/check-csp.mjs",
    "test:replay": "node tools/test-replay.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@supabase/supabase-js": "^2.111.0",
    "jsdom": "^29.1.1",
    "vite": "^5.4.11"
  }
}
